# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Paste Supabase's connection string as-is (plain postgresql://) — it's
# normalized to the psycopg3 driver in code (app/config.py:sqlalchemy_db_url).
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Claude
ANTHROPIC_API_KEY=

# Firecrawl (research/retrieval)
FIRECRAWL_API_KEY=

# Worker
WORKER_POLL_INTERVAL_SECONDS=5
JOB_MAX_ATTEMPTS=3
QUEUE_MAX_ATTEMPTS=3

# Auth
SESSION_COOKIE_NAME=koya_session
SESSION_TTL_MINUTES=60
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# App
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000


# Email Delivery
EMAIL_FROM_ADDRESS="email@from.com"
RESEND_API_KEY="resend-api-key"
EMAIL_FROM_NAME="Koya Talent"
# Inbox notified when a content request reaches in_review — no per-request
# reviewer assignment exists, so this is a single shared address.
REVIEWER_NOTIFICATION_EMAIL=
